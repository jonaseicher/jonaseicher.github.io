---
import Base from "../layouts/Base.astro";
import { industries, services, site, stack } from "../config/site";
---

<Base title={site.name}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{site.location} · Independent since {site.since}</p>
      <h1>{site.name}</h1>
      <p class="roles">{site.roles.join(" · ")}</p>
      <p class="lede">
        An independent engineering practice for organisations that need software
        built, platforms operated, and delivery run with a clear owner. Client
        work has covered medicine, telecommunications, insurance, automotive,
        games, automation, process engineering, logistics, startup mentoring,
        and aeronautics.
      </p>
      <p class="hero-actions">
        <a class="button" href="/contact">Start a conversation</a>
        <a class="text-link" href={site.linkedin} rel="noopener noreferrer"
          >LinkedIn</a
        >
      </p>
    </div>
  </section>

  <section class="wrap" aria-label="Practice facts">
    <dl class="facts">
      <div>
        <dt>Based</dt>
        <dd>{site.location}</dd>
      </div>
      <div>
        <dt>Independent</dt>
        <dd>Since {site.since}</dd>
      </div>
      <div>
        <dt>Formation</dt>
        <dd>Physics, LMU</dd>
      </div>
      <div>
        <dt>Contact</dt>
        <dd>One principal</dd>
      </div>
    </dl>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="section-label">Services</p>
        <a href="/services">All services</a>
      </div>
      <ol class="ledger">
        {
          services.map((service) => (
            <li>
              <span class="num">{service.number}</span>
              <div>
                <h2>{service.title}</h2>
                <p class="summary">{service.summary}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="section-label">Industries</p>
        <a href="/industries">Field notes</a>
      </div>
      <ul class="index">
        {
          industries.map((industry) => (
            <li>
              <a href={`/industries#${industry.id}`}>
                <strong>{industry.title}</strong>
                <span>{industry.summary}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap section">
      <p class="section-label">Expert network</p>
      <p>
        Larger and broader programmes draw on a wide field of external experts:
        engineers, designers, infrastructure specialists, and domain
        practitioners, engaged for the work at hand. Clients keep a single point
        of contact.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="section-label">Technology</p>
      <h2>The stack the practice builds and operates on.</h2>
      <ul class="stack">
        {stack.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="section-label">Contact</p>
      <h2>Tell us what you are trying to ship.</h2>
      <p class="lede">
        A new product, a platform that needs an owner, or a team that needs a
        steadier way of working. The first conversation is enough to see whether
        the practice is the right fit.
      </p>
      <p class="hero-actions">
        <a class="button" href="/contact">Contact</a>
        <a class="text-link" href="/practice">About the practice</a>
      </p>
    </div>
  </section>
</Base>
